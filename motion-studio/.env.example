# Copiez ce fichier en ".env" puis renseignez votre clé.
# La clé reste sur votre ordinateur, côté serveur : elle n'est jamais envoyée au navigateur.
# Créez une clé sur https://platform.claude.com (facturation à l'usage, distincte d'un abonnement Claude.ai).
ANTHROPIC_API_KEY=

# Modèle Claude utilisé (facultatif).
ANTHROPIC_MODEL=claude-opus-5-5

# Port du serveur local (facultatif).
PORT_SERVEUR=3210
