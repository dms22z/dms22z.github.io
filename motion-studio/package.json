{
  "name": "motion-studio",
  "version": "0.1.0",
  "description": "Logiciel de motion design assisté par IA (Claude + Remotion)",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "concurrently -k -n serveur,interface -c green,blue \"npm:serveur\" \"npm:interface\"",
    "serveur": "tsx server/index.ts",
    "interface": "vite --open",
    "studio-remotion": "remotion studio src/remotion/index.ts",
    "verifier": "tsc --noEmit -p tsconfig.json",
    "test": "tsx scripts/test-schema.ts && tsx scripts/test-rendu.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
